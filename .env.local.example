# Copy this file to .env.local and fill in the real values from your
# Supabase project (Project Settings > API). .env.local is gitignored,
# so it never gets committed.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefix this with NEXT_PUBLIC_, and never paste it
# into any client-side code. It bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=
